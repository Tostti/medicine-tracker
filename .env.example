POSTGRES_USER=appuser
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=appdb
POSTGRES_PORT=5432
POSTGRES_HOST=db

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=replace-with-another-strong-password
PGADMIN_PORT=5050

# Version of the published images to run (docker compose pull). On a server, pin a
# release like 1.2.0 (or 1.2 to get its fixes): the server only changes when you change
# this, and rolling back is setting the previous one. `latest` follows main, so every
# merge would be deployed on the next pull; sha-<commit> runs one exact build.
IMAGE_TAG=latest

# Port where the app is served (frontend + /api), behind the HTTPS reverse proxy.
WEB_PORT=8090
# Interface it listens on. 127.0.0.1 (default): only this machine, e.g. a reverse proxy
# or Tailscale Serve on the same host. 0.0.0.0: every interface, for a proxy in Docker or
# on another machine. The app has no login: read the README's Security section first.
WEB_BIND=127.0.0.1

# --- Image storage (S3-compatible) ---
# Leave S3_BUCKET empty to run without picture uploads.
#
# Bundled RustFS (MinIO-compatible): keep the profile and the storage endpoint.
# AWS: remove COMPOSE_PROFILES, leave S3_ENDPOINT_URL empty, set S3_REGION,
#      and either set the keys or leave them empty to use an IAM role.
# Another MinIO/S3 server: remove the profile and set its URL as S3_ENDPOINT_URL.
COMPOSE_PROFILES=storage
S3_ENDPOINT_URL=http://storage:9000
S3_REGION=us-east-1
S3_BUCKET=medicine-images
S3_ACCESS_KEY=medicine-tracker
S3_SECRET_KEY=change-me-at-least-8-chars
# Create the bucket on startup if missing (needs permission to do so on AWS).
S3_CREATE_BUCKET=true
STORAGE_CONSOLE_PORT=9001
